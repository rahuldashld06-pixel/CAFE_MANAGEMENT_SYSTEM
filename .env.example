# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values for local work.
# NEVER commit the real `.env`. On Render/Railway set these as
# environment variables in the dashboard instead.
# ---------------------------------------------------------------

# Set to "development" on your own machine. Anything else (or unset)
# is treated as production: SECRET_KEY becomes mandatory and secure
# cookies are switched on automatically.
APP_ENV=development

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START in production without this.
SECRET_KEY=

# --- Database (Aiven / PlanetScale / local MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_management

# TLS. Managed providers (Aiven, PlanetScale, DigitalOcean) require an
# encrypted connection. Download the provider's CA certificate, commit it
# as certs/ca.pem (it is a public certificate, not a secret), and point
# this at it so the connection is verified, not merely encrypted.
# Leave blank for a local MySQL.
DB_SSL_CA=
# Set to 0 only to debug a certificate problem. Never leave it off.
DB_SSL_VERIFY=1
# Set to 1 for a local MySQL built without TLS support.
DB_SSL_DISABLED=0

# Connections held per web worker. Keep workers x pool below your
# database plan's connection limit (Aiven free tier allows ~20).
DB_POOL_SIZE=5

# --- Platform branding (shown before sign-in, and as the default
#     name for a new cafe until its admin sets one) ---
CAFE_NAME=Cafe Manager

# Max upload size in MB for logos and food photos.
MAX_UPLOAD_MB=5

# How long a signed-in session lasts.
SESSION_HOURS=8

# Force secure cookies. Defaults to on in production, off in
# development. Only set this if you need to override.
# SESSION_COOKIE_SECURE=1

# --- Razorpay online payments (optional) ---
# Leave blank to disable the "Pay Online" button entirely.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin login OTP over SMS (optional) ---
# With no gateway configured the code is written to the server log
# and shown on screen, so the flow is testable without a provider.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
CAFE_OTP_SENDER_NAME=Cafe Manager
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
